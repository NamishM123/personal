# =====================================================================
# Server-side (set in Vercel → Project → Settings → Environment Variables).
# These NEVER reach the browser bundle.
# =====================================================================

# Origin your frontend is served from. Use "*" while developing.
ALLOWED_ORIGIN=*

# Groq API key (server-side). Used by api/groq.ts. Get one at
# https://console.groq.com/keys. If set, the client hits /api/groq
# on your deploy and the key never leaves the server.
GROQ_API_KEY=gsk_...

# Optional — only for the token-based Canvas REST path (api/canvas.ts).
# If you use the iCal path (api/ical.ts) leave these blank.
CANVAS_BASE_URL=https://canvas.your-school.edu
CANVAS_TOKEN=your_canvas_personal_access_token

# =====================================================================
# Client-side (set in .env.local for `npm run dev` only).
# These ARE included in the browser bundle — don't ship a real key here
# in production, use the server-side GROQ_API_KEY instead.
# =====================================================================

# Only needed if you want the LLM parse to work in local dev without
# running the serverless functions. In production, prefer GROQ_API_KEY
# above and leave this blank.
# VITE_GROQ_API_KEY=gsk_...
