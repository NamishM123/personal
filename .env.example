# Client-side. Sent to the browser bundle — only use with a personal-use key.
VITE_GROQ_API_KEY=gsk_...

# Server-side (Vercel/Netlify). NOT exposed to the browser.
CANVAS_BASE_URL=https://canvas.your-school.edu
CANVAS_TOKEN=your_canvas_personal_access_token
# Origin your frontend is served from. Use "*" while developing.
ALLOWED_ORIGIN=https://your-app.vercel.app
